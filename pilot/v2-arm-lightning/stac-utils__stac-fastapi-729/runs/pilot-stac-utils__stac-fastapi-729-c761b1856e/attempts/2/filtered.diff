+def _create_dataclass_with_post_init(model_name, bases):
+    """Create a dataclass that calls __post_init__ from all base classes.
+
+    The standard make_dataclass only calls __post_init__ from the first
+    class in the MRO that defines it. This function ensures all base
+    __post_init__ methods are called.
+    """
+    import types
+
+    # Create the class using types.new_class
+    model_cls = types.new_class(model_name, bases, {}, lambda ns: ns.update({}))
+
+    # Remove __post_init__ if present, so the dataclass decorator doesn't
+    # add its own call, and we can add our own that calls all bases
+    if "_POST_INIT_NAME" in model_cls.__dict__:
+        del model_cls.__dict__["_POST_INIT_NAME"]
+
+    # Apply the dataclass decorator
+    Model = dataclass(model_cls)
+
+    # Add our __post_init__ that calls all base __post_init methods
+    def __post_init__(self):
+        for base in Model.__mro__:
+            if base is Model:
+                continue
+            if "__post_init__" in base.__dict__:
+                base.__post_init__(self)
+
+    Model.__post_init__ = __post_init__
+
+    return Model
+
+
