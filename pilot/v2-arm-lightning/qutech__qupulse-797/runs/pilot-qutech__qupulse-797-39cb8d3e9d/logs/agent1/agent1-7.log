466: '    def _calc_sampled_segments(self) -> Tuple[Sequence[TaborSegment], Sequence[int]]:\n'
467: '        """\n'
468: '        Returns:\n'
469: '            (segments, segment_lengths)\n'
470: '        """\n'
471: '        time_array, segment_lengths = get_sample_times(self._parsed_program.waveforms, self._sample_rate)\n'
472: '\n'
473: '        if np.any(segment_lengths % 16 > 0) or np.any(segment_lengths < 192):\n'
474: "            raise TaborException('At least one waveform has a length that is smaller 192 or not a multiple of 16')\n"
475: '\n'
476: '        segments = []\n'
477: '        for i, waveform in enumerate(self._parsed_program.waveforms):\n'
478: '            t = time_array[:segment_lengths[i]]\n'
479: '            marker_time = t[::2]\n'
480: '            segment_a = self._channel_data(waveform, t, 0)\n'
481: '            segment_b = self._channel_data(waveform, t, 1)\n'
482: '            assert (len(segment_a) == len(t))\n'
483: '            assert (len(segment_b) == len(t))\n'
484: '            marker_a = self._marker_data(waveform, marker_time, 0)\n'
485: '            marker_b = self._marker_data(waveform, marker_time, 1)\n'
486: '            segment = TaborSegment.from_sampled(ch_a=segment_a,\n'
487: '                                   ch_b=segment_b,\n'
488: '                                   marker_a=marker_a,\n'
489: '                                   marker_b=marker_b)\n'
490: '            segments.append(segment)\n'
491: '        return segments, segment_lengths\n'
492: '\n'
493: '    def setup_single_sequence_mode(self) -> None:\n'
494: '        assert self.program.depth() == 1\n'
495: '        assert self.program.is_balanced()\n'
