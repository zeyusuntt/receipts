+    def diff(self, variable):
+        """Compute the derivative of the interpolant with respect to a variable.
+        
+        For 1D interpolants with a single child, the derivative can be computed
+        for cubic interpolators (using scipy's derivative method). For linear and
+        pchip interpolators, as well as multi-child interpolants, differentiation
+        is not implemented.
+        """
+        # If the variable is not one of our children, return 0
+        if variable not in self.orphans:
+            return pybamm.Scalar(0)
+        
+        # Check if we have more than one child - differentiation not implemented
+        if len(self.children) > 1:
+            raise NotImplementedError(
+                "differentiation not implemented for functions with more than one child"
+            )
+        
+        # For 1D interpolants with single child, try to compute derivative
+        if self.dimension == 1:
+            try:
+                # Try to use the scipy function's derivative method
+                # CubicSpline has derivative(), interp1d and PchipInterpolator don't
+                deriv_func = self.function.derivative()
+                return pybamm.Function(
+                    deriv_func,
+                    *self.children,
+                    derivative=self.derivative,
+                    differentiated_function=self.function,
+                )
+            except (AttributeError, NotImplementedError):
+                # If derivative method not available, raise NotImplementedError
+                raise NotImplementedError(
+                    "Differentiation not implemented for this interpolator type"
+                )
+        
+        # For 2D and 3D interpolants, not implemented
+        raise NotImplementedError(
+            "Differentiation not implemented for %dD interpolation" % self.dimension
+        )
