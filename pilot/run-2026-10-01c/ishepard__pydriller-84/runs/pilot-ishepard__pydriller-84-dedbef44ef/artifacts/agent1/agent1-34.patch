+#!/usr/bin/env python3
+
+from pydriller.repository_mining import RepositoryMining
+
+print("=== Testing the FIX ===")
+print("User should be able to specify range naturally AND get chronological output")
+print("Even when reversed_order=True (internally reverses traversal for efficiency)")
+
+lc = list(RepositoryMining('test-repos/small_repo',
+                           from_commit='1f99848edadfffa903b8ba1286a935f1b92b2845',  # Natural: earlier commit
+                           to_commit='6411e3096dd2070438a17b225f44475136e54e3a',     # Natural: later commit
+                           reversed_order=True).traverse_commits())  # Still want reverse traversal internally
+print(f"Got {len(lc)} commits:")
+for i, commit in enumerate(lc):
+    print(f"{i}: {commit.hash}")
+
+print("\n=== Verification: should be 1f99 -> 09f6 -> 6411 ===")
+expected = ['1f99848edadfffa903b8ba1286a935f1b92b2845', 
+            '09f6182cef737db02a085e1d018963c7a29bde5a',
+            '6411e3096dd2070438a17b225f44475136e54e3a']
+actual = [c.hash for c in lc]
+if actual == expected:
+    print("✓ SUCCESS: Got expected chronological order!")
+else:
+    print("✗ FAILURE: Expected", expected, "got", actual)
