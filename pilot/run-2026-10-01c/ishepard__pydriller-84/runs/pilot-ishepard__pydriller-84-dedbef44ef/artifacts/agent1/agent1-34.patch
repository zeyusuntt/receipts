         :param str filepath: only commits that modified this file will be
             analyzed
         """
+        # When reversed_order=True, we internally traverse commits in reverse 
+        # order (newest to oldest) but we want to present them as if they were
+        # traversed oldest to newest for consistency with user expectations.
+        # Therefore, we swap the from_commit and to_commit parameters so that
+        # when users specify their range naturally (earlier to later), 
+        # the internal reverse traversal still produces the correct output.
+        effective_from_commit = from_commit
+        effective_to_commit = to_commit
+        if reversed_order and from_commit and to_commit:
+            effective_from_commit = to_commit
+            effective_to_commit = from_commit
+            
         options = {
             "git_repo": None,
             "path_to_repo": path_to_repo,
-            "from_commit": from_commit,
