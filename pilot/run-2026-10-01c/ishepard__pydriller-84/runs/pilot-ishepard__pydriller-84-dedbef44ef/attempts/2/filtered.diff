+#!/usr/bin/env python3
+
+from pydriller.repository_mining import RepositoryMining
+
+print("=== Current behavior (what issue complains about) ===")
+print("User wants commits from 1f99... to 6411... in chronological order")
+print("But has to use reverse_order=True to get that...")
+lc = list(RepositoryMining('test-repos/small_repo',
+                           from_commit='6411e3096dd2070438a17b225f44475136e54e3a',  # User HAS to swap!
+                           to_commit='1f99848edadfffa903b8ba1286a935f1b92b2845',
+                           reversed_order=True).traverse_commits())
+for i, commit in enumerate(lc):
+    print(f"{i}: {commit.hash}")
+
+print("\n=== What user SHOULD be able to write ===")
+print("User should be able to simply specify the range normally:")
+lc = list(RepositoryMining('test-repos/small_repo',
+                           from_commit='1f99848edadfffa903b8ba1286a935f1b92b2845',  # Natural order
+                           to_commit='6411e3096dd2070438a17b225f44475136e54e3a',
+                           reversed_order=True).traverse_commits())  # But still get reverse traversal internally
+for i, commit in enumerate(lc):
+    print(f"{i}: {commit.hash}")
