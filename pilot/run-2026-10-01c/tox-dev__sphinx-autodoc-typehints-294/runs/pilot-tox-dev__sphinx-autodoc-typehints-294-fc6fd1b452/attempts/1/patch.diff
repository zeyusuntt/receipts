+#!/usr/bin/env python3
+
+# Test edge cases for the fix
+def test_case(lines_desc, initial_lines, insert_index):
+    print(f"\n=== {lines_desc} ===")
+    lines = initial_lines.copy()
+    
+    print("Before:")
+    for i, line in enumerate(lines):
+        print(f"{i}: {repr(line)}")
+    
+    # Insert :rtype:
+    formatted_annotation = ":py:obj:`None`"
+    lines.insert(insert_index, f":rtype: {formatted_annotation}")
+    
+    print("\nAfter inserting :rtype:")
+    for i, line in enumerate(lines):
+        print(f"{i}: {repr(line)}")
+    
+    # Apply our fix
+    if insert_index + 1 < len(lines) and lines[insert_index + 1].startswith(".."):
+        lines.insert(insert_index + 2, "")
+        print("\nApplied fix: inserted blank line after :rtype:")
+    
+    print("\nFinal:")
+    for i, line in enumerate(lines):
+        print(f"{i}: {repr(line)}")
+    
+    # Validation
+    rtype_index = insert_index  # Where we inserted it
+    success = True
+    if rtype_index + 1 < len(lines) and lines[rtype_index + 1].startswith(".."):
+        if not (rtype_index + 2 < len(lines) and lines[rtype_index + 2] == ""):
+            print(f"\nFAIL: Missing blank line after :rtype: at {rtype_index}")
+            success = False
+        else:
+            print(f"\nPASS: Correct blank line after :rtype: at {rtype_index}")
+    else:
+        print(f"\nINFO: No directive after :rtype: at {rtype_index} (fix not needed)")
+    
+    return success
+
+def run_all_tests():
+    all_passed = True
+    
+    # Test 1: :rtype: at start, followed by directive
+    all_passed &= test_case(
+        "Directive at start",
+        [".. rubric:: Notes", "", "Hello"],
+        0
+    )
+    
+    # Test 2: :rtype: in middle, followed by directive
+    all_passed &= test_case(
+        "Directive in middle",
+        ["Some text", "", ".. rubric:: Notes", "", "More"],
+        0
+    )
+    
+    # Test 3: :rtype: at end (no following lines)
+    all_passed &= test_case(
+        "At end",
+        ["Some text", "", "Hello"],
+        3  # Insert at end
+    )
+    
+    # Test 4: :rtype: followed by regular text (not directive)
+    all_passed &= test_case(
+        "Followed by text",
+        ["Some text", "", "Hello world", "", "End"],
+        0
+    )
+    
+    # Test 5: Empty lines
+    all_passed &= test_case(
+        "Empty followed by directive",
+        ["", ".. rubric:: Notes"],
+        0
+    )
+    
+    return all_passed
+
+if __name__ == "__main__":
+    success = run_all_tests()
+    print(f"\n\n{'ALL TESTS PASSED' if success else 'SOME TESTS FAILED'}")
+    exit(0 if success else 1)
