+#!/usr/bin/env python3
+
+# Final test to demonstrate the fix for the original issue
+def simulate_original_issue():
+    """Simulate the exact scenario from the issue report"""
+    
+    # This is what the docstring looks like when entering _inject_types_to_docstring
+    lines = [
+        ".. rubric:: Notes",
+        "",
+        "Hello, world.",
+        ""
+    ]
+    
+    print("=== ORIGINAL ISSUE SIMULATION ===")
+    print("Docstring entering _inject_types_to_docstring:")
+    for i, line in enumerate(lines):
+        print(f"{i:2}: {repr(line)}")
+    
+    # Simulate the insertion of :rtype: (this was the problematic behavior)
+    formatted_annotation = ":py:obj:`None`"
+    insert_index = 0  # :rtype: gets inserted at the beginning
+    
+    # OLD behavior (without fix): just insert the line
+    lines_old = lines.copy()
+    lines_old.insert(insert_index, f":rtype: {formatted_annotation}")
+    
+    print("\nOLD behavior result (problematic):")
+    for i, line in enumerate(lines_old):
+        print(f"{i:2}: {repr(line)}")
+    
+    # Check if OLD behavior causes the Sphinx warning
+    rtype_idx_old = None
+    for i, line in enumerate(lines_old):
+        if line.startswith(":rtype:"):
+            rtype_idx_old = i
+            break
+    
+    old_has_warning = False
+    if rtype_idx_old is not None and rtype_idx_old + 1 < len(lines_old):
+        next_line = lines_old[rtype_idx_old + 1]
+        if next_line.startswith(".."):
+            old_has_warning = True
+            print(f"\n❌ OLD behavior WOULD cause Sphinx warning:")
+            print(f"   Line {rtype_idx_old}: {repr(lines_old[rtype_idx_old])}")
+            print(f"   Line {rtype_idx_old + 1}: {repr(next_line)} (directive, no blank line after)")
+    
+    # NEW behavior (with fix): insert :rtype: and ensure blank line before directive
+    lines_new = lines.copy()
+    lines_new.insert(insert_index, f":rtype: {formatted_annotation}")
+    
+    # Apply our fix - SAME LOGIC AS IN THE ACTUAL CODE (CORRECTED)
+    print(f"   Debug: insert_index={insert_index}, len(lines_new)={len(lines_new)}")
+    if insert_index + 1 < len(lines_new):
+        print(f"   Debug: lines_new[{insert_index + 1}] = {repr(lines_new[insert_index + 1])}")
+        if lines_new[insert_index + 1].startswith(".."):
+            print(f"   Debug: Applying fix - inserting blank line at index {insert_index + 1}")
+            lines_new.insert(insert_index + 1, "")  # Insert BEFORE the directive
+        else:
+            print(f"   Debug: Not applying fix - next line is not a directive")
+    else:
+        print(f"   Debug: Not applying fix - insert_index + 1 >= len(lines_new)")
+    
+    print("\nNEW behavior result (fixed):")
+    for i, line in enumerate(lines_new):
+        print(f"{i:2}: {repr(line)}")
+    
+    # Check if NEW behavior avoids the Sphinx warning
+    rtype_idx_new = None
+    for i, line in enumerate(lines_new):
+        if line.startswith(":rtype:"):
+            rtype_idx_new = i
+            break
+    
+    new_has_warning = False
+    if rtype_idx_new is not None:
+        print(f"\n🔍 Checking :rtype: at line {rtype_idx_new}")
+        # What we want to avoid is: :rtype: followed immediately by a directive
+        # What we want is: :rtype:, blank line, directive
+        if rtype_idx_new + 1 < len(lines_new):
+            next_line = lines_new[rtype_idx_new + 1]
+            print(f"   Line {rtype_idx_new}:     {repr(lines_new[rtype_idx_new])} (:rtype:)")
+            print(f"   Line {rtype_idx_new + 1}:   {repr(next_line)}")
+            
+            if next_line.startswith(".."):
+                # PROBLEM: directive immediately after :rtype:
+                new_has_warning = True
+                print(f"   ❌ PROBLEM: Directive immediately after :rtype:")
+            elif next_line == "" and rtype_idx_new + 2 < len(lines_new):
+                # GOOD: blank line after :rtype:, check what comes after
+                second_next = lines_new[rtype_idx_new + 2]
+                print(f"   Line {rtype_idx_new + 2}:   {repr(second_next)}")
+                if second_next.startswith(".."):
+                    print(f"   ✅ GOOD: Blank line, then directive")
+                else:
+                    print(f"   ⚠️  Blank line but not followed by directive")
+            else:
+                print(f"   ℹ️  Other situation")
+        else:
+            print(f"   ℹ️  :rtype: at end of lines")
+    else:
+        print(f"   ℹ️  :rtype: not found")
+    
+    print(f"\nRESULT:")
+    print(f"   Old behavior would cause warning: {old_has_warning}")
+    print(f"   New behavior prevents warning: {not new_has_warning}")
+    
+    return not new_has_warning and old_has_warning
+
+if __name__ == "__main__":
+    success = simulate_original_issue()
+    print(f"\n{'🎉 FIX SUCCESSFUL' if success else '❌ FIX FAILED'}")
+    exit(0 if success else 1)
