+#!/usr/bin/env python3
+
+# Simple test to verify the fix for the spacing issue
+def my_function() -> None:
+    """
+    .. rubric:: Notes
+
+    Hello, world.
+    """
+    pass
+
+# Test the _inject_types_to_docstring function directly
+import inspect
+from sphinx.application import Sphinx
+from sphinx.config import Config
+from sphinx.ext.autodoc import Options
+from src.sphinx_autodoc_typehints import _inject_types_to_docstring
+
+# Create a mock Sphinx app
+app = Sphinx(srcdir=".", confdir=".", outdir=".", doctreedir=".", buildername="html", status=None)
+app.config.always_document_param_types = False
+app.config.typehints_document_rtype = True
+app.config.typehints_use_rtype = True
+app.config.typehints_defaults = None
+app.config.simplify_optional_unions = True
+app.config.typehints_formatter = None
+app.config.typehints_use_signature = False
+app.config.typehints_use_signature_return = False
+
+# Get the docstring lines
+lines = inspect.getdoc(my_function).split('\n')
+print("Original lines:")
+for i, line in enumerate(lines):
+    print(f"{i}: {repr(line)}")
+
+# Inject types
+_inject_types_to_docstring(
+    type_hints={"return": type(None)},  # None annotation
+    signature=inspect.signature(my_function),
+    original_obj=my_function,
+    app=app,
+    what="function",
+    name="my_function",
+    lines=lines
+)
+
+print("\nAfter injection:")
+for i, line in enumerate(lines):
+    print(f"{i}: {repr(line)}")
+
+# Check if we have proper spacing
+rtype_index = None
+for i, line in enumerate(lines):
+    if line.startswith(":rtype:"):
+        rtype_index = i
+        break
+
+if rtype_index is not None:
+    print(f"\nFound :rtype: at index {rtype_index}")
+    if rtype_index + 1 < len(lines):
+        next_line = lines[rtype_index + 1]
+        print(f"Next line: {repr(next_line)}")
+        if next_line.startswith(".."):
+            if rtype_index + 2 < len(lines) and lines[rtype_index + 2] == "":
+                print("SUCCESS: Blank line found after :rtype:")
+            else:
+                print("ISSUE: No blank line after :rtype: before directive")
+        else:
+            print("Next line is not a directive")
+    else:
+        print(":rtype: is at the end")
+else:
+    print(":rtype: not found")
