+#!/usr/bin/env python3
+
+import sys
+sys.path.insert(0, '.')
+
+from pymdownx.snippets import SnippetPreprocessor
+import codecs
+
+# Test the extract_section function directly
+config = {
+    'base_path': ['./tests/test_extensions/_snippets'],
+    'encoding': 'utf-8',
+    'check_paths': False,
+    'auto_append': [],
+    'url_download': False,
+    'url_max_size': 33554432,
+    'url_timeout': 10.0,
+    'url_request_headers': {},
+    'dedent_subsections': False
+}
+
+# Create a mock md object with tab_length
+class MockMd:
+    tab_length = 4
+
+snippet = SnippetPreprocessor(config, MockMd())
+
+# Test extracting the section
+with codecs.open('./tests/test_extensions/_snippets/section_nested.txt', 'r', encoding='utf-8') as f:
+    lines = [l.rstrip('\r\n') for l in f]
+
+print("File lines:")
+for i, line in enumerate(lines):
+    print(f"{i:2}: {line}")
+
+print("\nTrying to extract section 'css-section5':")
+result = snippet.extract_section('css-section5', lines)
+print("Result lines:")
+for i, line in enumerate(result):
+    print(f"{i:2}: {line}")
+
+print("\nJoined result:")
+print(repr('\\n'.join(result)))
