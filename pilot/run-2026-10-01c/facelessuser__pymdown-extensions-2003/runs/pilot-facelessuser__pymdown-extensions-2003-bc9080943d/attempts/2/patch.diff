+#!/usr/bin/env python3
+
+import os
+import sys
+sys.path.insert(0, '.')
+
+from tests import util
+import os
+from pymdownx.snippets import SnippetMissingError
+
+BASE = os.path.abspath(os.path.dirname('./tests/test_extensions/test_snippets.py'))
+
+class TestSnippets(util.MdCase):
+    """Test snippet cases."""
+
+    extension = [
+        'pymdownx.snippets', 'pymdownx.superfences'
+    ]
+
+    extension_configs = {
+        'pymdownx.snippets': {
+            'base_path': [os.path.join(BASE, '_snippets')]
+        }
+    }
+
+    def test_section_ignore_double_start_section(self):
+        """Test nested sections."""
+        
+        print("Testing section_ignore_double_start_section")
+        self.check_markdown(
+            R'''
+            ```
+            -8<- "section_nested.txt:css-section5"
+            ```
+            ''',  # noqa: W291
+            '''
+            <div class="highlight"><pre><span></span><code>div {
+                color: red;
+                background-color: white;
+                padding: 16px
+            }
+            </code></pre></div>
+            ''',
+            True
+        )
+
+if __name__ == '__main__':
+    test_instance = TestSnippets()
+    test_instance.setUp()
+    try:
+        test_instance.test_section_ignore_double_start_section()
+        print("TEST PASSED")
+    except Exception as e:
+        print("TEST FAILED:", str(e))
+        import difflib
+        # Let's manually check what we got
+        import markdown
+        md = markdown.Markdown(extensions=['pymdownx.snippets', 'pymdownx.superfences'])
+        md.set_output_format('html')
+        config = {
+            'base_path': [os.path.join(BASE, '_snippets')]
+        }
+        md.preprocessors[md.preprocessors.registered['snippet']].__init__(config, md)
+        
+        test_input = '''
+        ```
+        -8<- "section_nested.txt:css-section5"
+        ```
+        '''
+        result = md.convert(test_input)
+        print("INPUT:")
+        print(repr(test_input))
+        print("OUTPUT:")
+        print(repr(result))
+        print("OUTPUT (formatted):")
+        print(result)
