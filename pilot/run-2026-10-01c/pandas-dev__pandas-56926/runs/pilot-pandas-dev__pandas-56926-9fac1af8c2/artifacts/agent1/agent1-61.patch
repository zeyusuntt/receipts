+import pandas as pd
+import numpy as np
+
+# Debug n=2 case
+df = pd.DataFrame({'x': [i for i in range(4)]})  # [0,1,2,3]
+df.index = pd.to_datetime(df['x'], unit='s')
+
+n = 2
+print(f"Testing n={n}")
+print(f"DataFrame values: {df['x'].tolist()}")
+
+res1 = df.resample('{}s'.format(n)).apply(lambda x: x.quantile(0.5, interpolation='nearest')).iloc[0][0]
+res2 = df.resample('{}s'.format(n)).quantile(0.5, interpolation='nearest').iloc[0][0]
+
+print(f"Apply result: {res1}")
+print(f"Direct quantile result: {res2}")
+
+# First group is [0, 1]
+first_group = df['x'][:n].values
+print(f"First group: {first_group.tolist()}")
+
+# Check what each method gives
+s_first = pd.Series(first_group)
+print(f"Series.quantile: {s_first.quantile(0.5, interpolation='nearest')}")
+print(f"NumPy percentile: {np.percentile(first_group, 50, method='nearest')}")
+
+# Manual calculation for [0, 1]
+sorted_vals = np.sort(first_group)
+print(f"Sorted values: {sorted_vals}")
+n_len = len(sorted_vals)
+pos = 0.5 * (n_len - 1)
+print(f"Position for q=0.5: 0.5 * ({n_len}-1) = {pos}")
+idx = int(pos)
+frac = pos - idx
+print(f"Index: {idx}, Fraction: {frac}")
+print(f"Value at index {idx}: {sorted_vals[idx]}")
+print(f"Value at index {idx+1}: {sorted_vals[idx+1]}")
+print(f"Since frac={frac}:")
+if frac > 0.5:
+    print("  > 0.5 → pick HIGHER value")
+elif frac < 0.5:
+    print("  < 0.5 → pick LOWER value")
+else:  # frac == 0.5
+    print("  == 0.5 → tie breaker:")
+    print(f"    q_val > 0.5 is {0.5 > 0.5} → {'' if 0.5 > 0.5 else 'NOT'} greater")
+    print(f"    Current code picks: {'HIGHER' if 0.5 > 0.5 else 'LOWER'} value")
