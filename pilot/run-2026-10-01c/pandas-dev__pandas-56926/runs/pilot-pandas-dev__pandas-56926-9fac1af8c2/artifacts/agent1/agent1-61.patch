+import pandas as pd
+import numpy as np
+
+# Exact reproduction from the issue (assuming n=50 based on the expected results)
+df = pd.DataFrame({'x': [i for i in range(100)]})
+df.index = pd.to_datetime(df['x'], unit='s')
+
+# Using n=50 to get 2 groups of 50 elements each
+n = 50
+res1 = df.resample('{}s'.format(n)).apply(lambda x: x.quantile(0.5, interpolation='nearest')).iloc[0][0]
+res2 = df.resample('{}s'.format(n)).quantile(0.5, interpolation='nearest').iloc[0][0]
+
+print("result from Resample.apply(lambda x: x.quantile(0.5, interpolation='nearest'): \t{}".format(res1))
+print("result from Resample.quantile(q=0.5, interpolation='nearest'): \t{}".format(res2))
+
+# Check if they match now
+print("Results match:", res1 == res2)
+
+# Also test what we expect
+# First group is [0, 1, 2, ..., 49] 
+# For n=50, position = 0.5 * (50-1) = 24.5
+# So we're between sorted[24]=24 and sorted[25]=25
+# Index=24 (even), so with round-half-to-even we pick index 24 = 24
+expected = 24
+print(f"Expected result: {expected}")
+print(f"Apply matches expected: {res1 == expected}")
+print(f"Direct matches expected: {res2 == expected}")
