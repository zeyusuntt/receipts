+import pandas as pd
+import numpy as np
+
+# Recreate the failing test case
+a_vals = [np.nan, 4.0, np.nan, 2.0, np.nan]
+s = pd.Series(a_vals)
+print("Original series:", s.tolist())
+print("After dropping NaN:", s.dropna().tolist())
+
+# What does Series.quantile return?
+result = s.quantile(0.5, interpolation='nearest')
+print("Series.quantile(0.5, interpolation='nearest'):", result)
+
+# What does numpy return?
+clean_vals = s.dropna().values
+print("Clean values:", clean_vals)
+numpy_result = np.percentile(clean_vals, 50, method='nearest')
+print("NumPy percentile:", numpy_result)
+
+# Manual calculation
+sorted_vals = np.sort(clean_vals)
+print("Sorted values:", sorted_vals)
+n = len(sorted_vals)
+print(f"n={n}")
+print(f"Position = q * (n-1) = 0.5 * {n-1} = {0.5 * (n-1)}")
+idx = int(0.5 * (n-1))
+frac = 0.5 * (n-1) - idx
+print(f"idx={idx}, frac={frac}")
+print(f"Values at idx={idx} and idx+1={idx+1}: {sorted_vals[idx]}, {sorted_vals[idx+1]}")
