+import numpy as np
+
+# Test what NumPy actually does for various cases
+test_cases = [
+    ([0, 1], 0.5),           # n=2, q=0.5 -> position 0.5
+    ([0, 1, 2, 3], 0.5),     # n=4, q=0.5 -> position 1.5  
+    ([0, 1, 2, 3, 4, 5], 0.5), # n=6, q=0.5 -> position 2.5
+]
+
+for arr, q in test_cases:
+    arr = np.array(arr)
+    pos = q * (len(arr) - 1)
+    idx = int(pos)
+    frac = pos - idx
+    result = np.percentile(arr, q * 100, method='nearest')
+    
+    print(f"Array {arr.tolist()}, q={q}")
+    print(f"  Position: {pos} (index {idx}, frac {frac})")
+    print(f"  Values around: [{arr[idx] if idx < len(arr) else 'OOB'}, {arr[idx+1] if idx+1 < len(arr) else 'OOB'}]")
+    print(f"  NumPy result: {result}")
+    print()
