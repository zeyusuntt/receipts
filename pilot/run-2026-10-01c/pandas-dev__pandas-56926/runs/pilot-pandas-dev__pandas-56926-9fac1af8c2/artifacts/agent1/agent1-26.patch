+import pandas as pd
+import numpy as np
+
+# Reproduce the issue from the bug report
+df = pd.DataFrame({'x': [i for i in range(100)]})
+df.index = pd.to_datetime(df['x'], unit='s')
+
+# Test with n=2 second intervals to get groups of 2 elements each
+n = 2
+res1 = df.resample('{}S'.format(n)).apply(lambda x: x.quantile(0.5, interpolation='nearest')).iloc[0][0]
+res2 = df.resample('{}S'.format(n)).quantile(0.5, interpolation='nearest').iloc[0][0]
+
+print("First few groups:")
+print("Values:", df['x'][:10].tolist())
+print("Groups of 2:", [df['x'][i:i+n].tolist() for i in range(0, 10, n)])
+print()
+
+print("Result from Resample.apply(lambda x: x.quantile(0.5, interpolation='nearest')): {}".format(res1))
+print("Result from Resample.quantile(q=0.5, interpolation='nearest'): {}".format(res2))
+
+# Let's also check what numpy does directly
+test_group = np.array([0, 1])  # First group
+print("\nFor group [0, 1]:")
+print("NumPy percentile with method='nearest':", np.percentile(test_group, 50, method='nearest'))
+
+# Test with larger groups to see the pattern
+print("\nTesting with groups of 10:")
+df2 = pd.DataFrame({'x': [i for i in range(20)]})  # 0-19
+df2.index = pd.to_datetime(df2['x'], unit='s')
+n2 = 10
+res1_2 = df2.resample('{}S'.format(n2)).apply(lambda x: x.quantile(0.5, interpolation='nearest')).iloc[0][0]
+res2_2 = df2.resample('{}S'.format(n2)).quantile(0.5, interpolation='nearest').iloc[0][0]
+print("First group values:", df2['x'][:10].tolist())
+print("Apply result:", res1_2)
+print("Direct quantile result:", res2_2)
+print("NumPy on [0,1,...,9]:", np.percentile(np.arange(10), 50, method='nearest'))
