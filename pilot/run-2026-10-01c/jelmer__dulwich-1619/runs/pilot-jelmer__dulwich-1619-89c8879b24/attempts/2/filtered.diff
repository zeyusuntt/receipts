+#!/usr/bin/env python3
+
+import os
+import tempfile
+import shutil
+from dulwich.repo import Repo
+from dulwich.porcelain import get_untracked_paths, path_to_tree_path, open_repo_closing
+from dulwich.ignore import IgnoreFilterManager
+
+# Create a simple test case
+temp_dir = tempfile.mkdtemp()
+try:
+    os.chdir(temp_dir)
+    print(f"Working in: {temp_dir}")
+    os.system('git init >/dev/null 2>&1')
+    
+    # Create untracked directory with files
+    os.makedirs('untracked_dir', exist_ok=True)
+    with open('untracked_dir/file1.txt', 'w') as f:
+        f.write('content1')
+    with open('untracked_dir/file2.txt', 'w') as f:
+        f.write('content2')
+        
+    print("Files created:")
+    os.system('find . -not -path "./.git/*" -not -path "./.git" | sort')
+    
+    print("\nTesting get_untracked_paths directly:")
+    with open_repo_closing('.') as r:
+        index = r.open_index()
+        ignore_manager = IgnoreFilterManager.from_repo(r)
+        paths = list(get_untracked_paths(
+            '.', '.', index, exclude_ignored=False, untracked_files="normal"
+        ))
+        print(f"Untracked paths (normal): {paths}")
+        
+    print("\nGit status:")
+    os.system('git status --porcelain')
+finally:
+    os.chdir('/')
+    shutil.rmtree(temp_dir)
