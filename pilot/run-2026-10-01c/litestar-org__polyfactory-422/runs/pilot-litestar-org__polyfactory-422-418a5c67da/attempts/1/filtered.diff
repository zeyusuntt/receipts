+++ b/debug_list.py
@@ -0,0 +1,42 @@
+from typing import List
+from typing_extensions import get_origin, get_args
+
+# Test how List[int] works
+list_int = List[int]
+print("List[int]:", list_int)
+print("type:", type(list_int))
+print("origin:", get_origin(list_int))
+print("args:", get_args(list_int))
+
+# Manual reconstruction
+origin = get_origin(list_int)
+args = get_args(list_int)
+print("\nReconstruction:")
+print("origin:", origin)
+print("args:", args)
+try:
+    reconstructed = origin[tuple(args)]
+    print("reconstructed:", reconstructed)
+    print("equal?", list_int == reconstructed)
+except Exception as e:
+    print("error:", e)
+
+# Test Required
+from typing_extensions import Required
+required_str = Required[str]
+print("\nRequired[str]:", required_str)
+print("type:", type(required_str))
+print("origin:", get_origin(required_str))
+print("args:", get_args(required_str))
+
+print("\nReconstruction Required:")
+origin_req = get_origin(required_str)
+args_req = get_args(required_str)
+print("origin:", origin_req)
+print("args:", args_req)
+try:
+    reconstructed_req = origin_req[tuple(args_req)]
+    print("reconstructed:", reconstructed_req)
+    print("equal?", required_str == reconstructed_req)
+except Exception as e:
+    print("error:", e)
