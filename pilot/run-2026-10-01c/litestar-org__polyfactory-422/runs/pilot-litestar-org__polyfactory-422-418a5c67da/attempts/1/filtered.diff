+from typing_extensions import TypedDict, Required, get_type_hints
+import sys
+
+class Foo(TypedDict, total=False):
+    name: Required[str]
+    bar: str
+
+print("Python version:", sys.version)
+print("Annotations:")
+model_type_hints = get_type_hints(Foo, include_extras=True)
+for field_name, annotation in model_type_hints.items():
+    print(f"  {field_name}: {annotation!r} (type: {type(annotation)})")
+    
+    from typing_extensions import get_origin, get_args
+    print(f"    origin: {get_origin(annotation)!r}")
+    print(f"    args: {get_args(annotation)!r}")
+    
+    # Check if it's Required
+    from typing_extensions import Required as RequiredType
+    print(f"    is Required Type: {annotation is RequiredType}")
+    print(f"    == Required: {annotation == RequiredType}")
