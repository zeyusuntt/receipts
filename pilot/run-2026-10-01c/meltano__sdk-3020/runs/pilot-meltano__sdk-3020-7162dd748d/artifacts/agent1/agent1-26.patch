+#!/usr/bin/env python3
+
+# Test script to reproduce the issue
+import sys
+sys.path.insert(0, '.')
+
+from singer_sdk.sinks.sql import SQLSink
+from singer_sdk.connectors import SQLConnector
+
+class DummyConnector(SQLConnector):
+    def __init__(self, config):
+        super().__init__(config)
+        
+    def prepare_schema(self, schema_name):
+        pass
+        
+    def prepare_table(self, full_table_name, schema, primary_keys, as_temp_table=False):
+        pass
+        
+    def bulk_insert_records(self, full_table_name, schema, records):
+        pass
+
+class DummyTarget:
+    def __init__(self):
+        self.config = {}
+
+class DummySink(SQLSink[DummyConnector]):
+    connector_class = DummyConnector
+    
+    def process_batch(self, context):
+        pass
+
+# Test the problematic case
+schema = {"type": "object", "properties": {"id": {"type": "string"}}}
+
+print("--- Test case from issue ---")
+target = DummyTarget()
+sink = DummySink(target, "tap_bigquery-weekly_fuel_prices", schema, ["id"])
+print(f"Stream name: {sink.stream_name}")
+print(f"Table name: {sink.table_name}")  # What does this produce?
+print(f"Schema name: {sink.schema_name}")
+
+# What we want: table name should be based on full stream name, not just part after last hyphen
+# Current behavior with conform_name: "tap_bigquery-weekly_fuel_prices" -> "tap_bigquery_weekly_fuel_prices"
+
+print("\n--- Simple name ---")
+sink2 = DummySink(target, "simple_stream", schema, ["id"])
+print(f"Stream name: {sink2.stream_name}")
+print(f"Table name: {sink2.table_name}")
+print(f"Schema name: {sink2.schema_name}")
+
+print("\n--- Hyphenated simple ---")
+sink3 = DummySink(target, "foo-bar", schema, ["id"])
+print(f"Stream name: {sink3.stream_name}")
+print(f"Table name: {sink3.table_name}")
+print(f"Schema name: {sink3.schema_name}")
