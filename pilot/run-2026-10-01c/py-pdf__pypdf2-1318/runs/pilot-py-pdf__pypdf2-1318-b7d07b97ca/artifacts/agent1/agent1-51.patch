diff --git a/PyPDF2/_reader.py b/PyPDF2/_reader.py
index 558d386..7207104 100644
--- a/PyPDF2/_reader.py
+++ b/PyPDF2/_reader.py
@@ -1344,18 +1344,42 @@ class PdfReader:
         # if not zero-indexed, verify that the table is correct; change it if necessary
         if self.xref_index and not self.strict:
             loc = stream.tell()
+            zeroized_generations = set()
             for gen, xref_entry in self.xref.items():
                 if gen == 65535:
                     continue
-                for id in xref_entry:
+                # Check if zeroizing makes sense by sampling a few entries
+                should_zeroize = False
+                samples_checked = 0
+                samples_matching = 0
+                for id in list(xref_entry.keys())[:3]:  # Check first 3 entries
                     stream.seek(xref_entry[id], 0)
                     try:
                         pid, _pgen = self.read_object_header(stream)
                     except ValueError:
-                        break
-                    if pid == id - self.xref_index:
-                        self._zero_xref(gen)
-                        break
+                        continue
+                    samples_checked += 1
+                    expected_id_after_zeroize = id - self.xref_index
+                    if pid == expected_id_after_zeroize:
+                        samples_matching += 1
+                    # Also sanity check: resulting ID should be non-negative
+                    if expected_id_after_zeroize < 0:
+                        break  # Don't zeroize if it would create negative IDs
+                if samples_checked > 0 and samples_matching == samples_checked:
+                    should_zeroize = True
+                
+                if should_zeroize:
+                    for id in xref_entry:
+                        stream.seek(xref_entry[id], 0)
+                        try:
+                            pid, _pgen = self.read_object_header(stream)
+                        except ValueError:
+                            break
+                        if pid == id - self.xref_index:
+                            if gen not in zeroized_generations:
+                                self._zero_xref(gen)
+                                zeroized_generations.add(gen)
+                            break
                     # if not, then either it's just plain wrong, or the
                     # non-zero-index is actually correct
             stream.seek(loc, 0)  # return to where it was
@@ -1754,6 +1778,11 @@ class PdfReader:
         self.xref[generation] = {
             k - self.xref_index: v for (k, v) in list(self.xref[generation].items())
         }
+        # Also zeroize the free entry tracking to keep it in sync
+        if generation in self.xref_free_entry:
+            self.xref_free_entry[generation] = {
+                k - self.xref_index: v for (k, v) in list(self.xref_free_entry[generation].items())
+            }
 
     def _pairs(self, array: List[int]) -> Iterable[Tuple[int, int]]:
         i = 0
