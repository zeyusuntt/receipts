            phase_builder = DescentPhase
        else:
            raise ValueError(
                f'{phase_name} does not have an associated phase_builder \n phase_name must '
                'include one of: groundroll, rotation, accel, ascent, climb, cruise, or desc'
            )

        return phase_builder

