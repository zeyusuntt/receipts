@@ -0,0 +1,75 @@
+from git import Repo
+import tempfile
+import os
+
+# Create a temporary repo
+repo_dir = tempfile.mkdtemp()
+print(f"Using repo dir: {repo_dir}")
+os.chdir(repo_dir)
+
+# Initialize repo
+repo = Repo.init(repo_dir)
+
+# Create a test file
+test_file = os.path.join(repo_dir, "test.txt")
+with open(test_file, "w") as f:
+    f.write("hello world\n")
+
+# Add and commit
+repo.git.add(test_file)
+repo.index.commit("initial commit")
+
+# Modify the file
+with open(test_file, "w") as f:
+    f.write("hello world\nmodified line\n")
+
+print("Without create_patch:")
+print(repo.index.diff("HEAD"))
+print(repo.index.diff(None))
+
+print("\nWith create_patch:")
+print("HEAD vs HEAD^:", repo.head.commit.diff("HEAD^", create_patch=True))  # tree vs tree
+print("index vs HEAD:", repo.index.diff("HEAD", create_patch=True))        # index vs tree  
+print("index vs working:", repo.index.diff(None, create_patch=True))      # index vs working tree
+print("working tree vs HEAD:", repo.head.commit.diff(None, create_patch=True)) # working tree vs tree
+
+# Set external diff
+with repo.config_writer(config_level="repository") as writer:
+    writer.set_value("diff", "external", "bogus_diff_engine")
+
+print("\n=== WITH EXTERNAL DIFF ===")
+print("Without create_patch:")
+try:
+    print("HEAD vs HEAD^:", repo.head.commit.diff("HEAD^"))  # tree vs tree
+except Exception as e:
+    print("HEAD vs HEAD^: ERROR -", e)
+try:
+    print("index vs HEAD:", repo.index.diff("HEAD"))        # index vs tree  
+except Exception as e:
+    print("index vs HEAD: ERROR -", e)
+try:
+    print("index vs working:", repo.index.diff(None))      # index vs working tree
+except Exception as e:
+    print("index vs working: ERROR -", e)
+try:
+    print("working tree vs HEAD:", repo.head.commit.diff(None)) # working tree vs tree
+except Exception as e:
+    print("working tree vs HEAD: ERROR -", e)
+
+print("\nWith create_patch:")
+try:
+    print("HEAD vs HEAD^:", repo.head.commit.diff("HEAD^", create_patch=True))  # tree vs tree
+except Exception as e:
+    print("HEAD vs HEAD^: ERROR -", e)
+try:
+    print("index vs HEAD:", repo.index.diff("HEAD", create_patch=True))        # index vs tree  
+except Exception as e:
+    print("index vs HEAD: ERROR -", e)
+try:
+    print("index vs working:", repo.index.diff(None, create_patch=True))      # index vs working tree
+except Exception as e:
+    print("index vs working: ERROR -", e)
+try:
+    print("working tree vs HEAD:", repo.head.commit.diff(None, create_patch=True)) # working tree vs tree
+except Exception as e:
+    print("working tree vs HEAD: ERROR -", e)
