struct VSInput {
    float2 texCoord : TEXCOORD0;
}
struct VSOutput {
    float4 color : COLOR;
}
// Texture Samplers
Texture2D iChannel0 :register(t0);
// Vertex Shader
VSOutput VSMain(VSInput input )  {
    VSOutput output;
    if (input.texCoord.x > 0.5) {
         output.color = vec4(1.0, 1.0, 1.0, 1.0);
    } else {
         output.color = vec4(0.0, 0.0, 0.0, 1.0);
    }
     output.color = vec4(input.texCoord, 0.0, 1.0);
    return  output;
}

// Fragment Shader
float4 PSMain(VSOutput input ) : SV_TARGET {
    float brightness = texture( iChannel0, input.color.xy).r;
    float bloom = max(0.0,  brightness - 0.5);
    if ( bloom > 0.5) {
         bloom = 0.5;
    } else {
         bloom = 0.0;
    }
    float3 texColor = texture( iChannel0, input.color.xy).rgb;
    float3 colorWithBloom =  texColor + vec3( bloom);
    return vec4( colorWithBloom, 1.0);
}


