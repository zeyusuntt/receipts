+#!/usr/bin/env python3
+
+# Copy the relevant parts of build.py with debug prints
+import tempfile
+import os
+import shutil
+from pathlib import Path
+
+def test_with_debug():
+    # Create a test repo like the test does
+    test_dir = tempfile.mkdtemp()
+    print(f"Test dir: {test_dir}")
+    old_cwd = os.getcwd()
+    os.chdir(test_dir)
+    
+    try:
+        # Set up the project like the test
+        os.makedirs("foo/newsfragments")
+        
+        with open("foo/__init__.py", "w") as f:
+            f.write("")
+            
+        with open("pyproject.toml", "w") as f:
+            f.write("""
+[tool.towncrier]
+package = "foo"
+filename = "NEWS.md"
+title_format = "[{project_date}] CUSTOM RELEASE for {name} version {version}"
+""")
+
+        with open("foo/newsfragments/123.feature", "w") as f:
+            f.write("Adds levitation")
+
+        # Now let's manually call the build logic with debug
+        from towncrier._settings.load import load_config_from_options
+        from towncrier.build import _main as towncrier_main
+        from click.testing import CliRunner
+        
+        runner = CliRunner()
+        
+        # Let's patch the render_fragments function to add debug info
+        import towncrier.build
+        original_render = towncrier.build.render_fragments
+        
+        def debug_render_fragments(*args, **kwargs):
+            print("=== DEBUG RENDER_FRAGMENTS CALL ===")
+            print(f"Args length: {len(args)}")
+            print(f"Kwargs keys: {list(kwargs.keys())}")
+            if 'sections' in kwargs:
+                print(f"Sections: {kwargs['sections']}")
+            if 'render_title' in kwargs:
+                print(f"Render title: {kwargs['render_title']}")
+            if 'template' in kwargs:
+                print(f"Template preview: {repr(kwargs['template'])[:200]}...")
+            print("===================================")
+            
+            result = original_render(*args, **kwargs)
+            print(f"Render result preview: {repr(result)[:200]}...")
+            return result
+        
+        towncrier.build.render_fragments = debug_render_fragments
+        
+        # Run the command
+        result = runner.invoke(
+            towncrier_main,
+            [
+                "--name",
+                "FooBarBaz",
+                "--version",
+                "7.8.9",
+                "--date",
+                "20-01-2001",
+                "--draft",
+            ],
+        )
+        
+        print("=== FINAL OUTPUT ===")
+        print(repr(result.output))
+        print("-------------------")
+        print(result.output)
+        print("====================")
+        
+        return result
+        
+    finally:
+        os.chdir(old_cwd)
+        shutil.rmtree(test_dir)
+
+if __name__ == "__main__":
+    test_with_debug()
