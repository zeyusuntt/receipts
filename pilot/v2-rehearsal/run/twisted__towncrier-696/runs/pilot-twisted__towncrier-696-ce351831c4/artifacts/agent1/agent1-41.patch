+#!/usr/bin/env python3
+
+from textwrap import dedent
+from twisted.trial.unittest import TestCase
+
+# Recreate the test logic
+expected_output = dedent(
+    """\
+    Loading template...
+    Finding news fragments...
+    Rendering news fragments...
+    Draft only -- nothing has been written.
+    What is seen below is what would be written.
+
+    [20-01-2001] CUSTOM RELEASE for FooBarBaz version 7.8.9
+
+    # Features
+
+    - Adds levitation (#123)
+
+
+
+    """
+)
+
+print("EXPECTED (from test file):")
+print(repr(expected_output))
+
+# Now let's get the ACTUAL output by running the test code
+import tempfile
+import os
+import shutil
+from click.testing import CliRunner
+
+test_dir = tempfile.mkdtemp()
+old_cwd = os.getcwd()
+os.chdir(test_dir)
+
+try:
+    # Set up like the test
+    os.makedirs("foo/newsfragments")
+    
+    with open("foo/__init__.py", "w") as f:
+        f.write("")
+        
+    with open("pyproject.toml", "w") as f:
+        f.write("""
+[tool.towncrier]
+package = "foo"
+filename = "NEWS.md"
+title_format = "[{project_date}] CUSTOM RELEASE for {name} version {version}"
+""")
+
+    with open("foo/newsfragments/123.feature", "w") as f:
+        f.write("Adds levitation")
+
+    from towncrier.build import _main as towncrier_main
+    runner = CliRunner()
+    
+    result = runner.invoke(
+        towncrier_main,
+        [
+            "--name",
+            "FooBarBaz",
+            "--version",
+            "7.8.9",
+            "--date",
+            "20-01-2001",
+            "--draft",
+        ],
+    )
+    
+    actual_output = result.output
+    
+    print("\nACTUAL (from running code):")
+    print(repr(actual_output))
+    
+    print(f"\nMatch: {actual_output == expected_output}")
+    
+    if actual_output != expected_output:
+        print("\nDIFFERENCE:")
+        for i, (a, b) in enumerate(zip(actual_output, expected_output)):
+            if a != b:
+                print(f"Position {i}: actual={repr(a)} expected={repr(b)}")
+                # Show some context
+                start = max(0, i-10)
+                end = min(len(actual_output), i+10)
+                print(f"  Actual context: {repr(actual_output[start:end])}")
+                print(f"  Expected context: {repr(expected_output[start:end])}")
+                break
+        else:
+            if len(actual_output) != len(expected_output):
+                print(f"Length mismatch: actual={len(actual_output)}, expected={len(expected_output)}")
+                print(f"Actual ends with: {repr(actual_output[-20:])}")
+                print(f"Expected ends with: {repr(expected_output[-20:])}")
+    
+finally:
+    os.chdir(old_cwd)
+    shutil.rmtree(test_dir)
