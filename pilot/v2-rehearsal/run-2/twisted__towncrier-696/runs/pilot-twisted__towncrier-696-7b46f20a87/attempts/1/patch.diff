+def _adjust_markdown_header_levels(content: str, base_level: int) -> str:
+    """
+    Adjust markdown header levels by adding base_level to each header.
+    
+    Converts:
+    # Header → #### Header (when base_level=3)
+    ## Subheader → ##### Subheader (when base_level=3)
+    """
+    lines = content.split('\n')
+    adjusted_lines = []
+    
+    for line in lines:
+        # Check if line starts with markdown header markers (after optional whitespace)
+        stripped_line = line.lstrip()
+        if stripped_line.startswith('#'):
+            # Count leading whitespace to preserve it
+            leading_whitespace = line[:len(line) - len(stripped_line)]
+            
+            # Count existing header markers in stripped line
+            header_count = 0
+            for char in stripped_line:
+                if char == '#':
+                    header_count += 1
+                else:
+                    break
+            
+            # Create new header with adjusted level (can be negative)
+            new_header_level = header_count + base_level
+            # Ensure we don't go below 0
+            new_header_level = max(0, new_header_level)
+            new_line = leading_whitespace + '#' * new_header_level + stripped_line[header_count:]
+            adjusted_lines.append(new_line)
+        else:
+            adjusted_lines.append(line)
+    
+    return '\n'.join(adjusted_lines)
+
