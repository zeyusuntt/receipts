+def _gh_exception(exc_cls, *args):
+    """Instantiate a GitHub exception, compatible with changes in PyGithub.
+    Some exceptions (e.g. BadCredentialsException) now require a ``headers``
+    argument. If only two arguments are provided, assume ``headers=None``.
+    """
+    if exc_cls is gh.BadCredentialsException and len(args) == 2:
+        # status, data -> add headers
+        return exc_cls(args[0], args[1], None)
+    return exc_cls(*args)
