+        print(f"  [{j}]: {repr(item)} (type: {type(item).__name__})")
+        
+# Expected: (42, True, 'Something', None, 'a')
+expected = (42, True, 'Something', None, 'a')
+print(f"\nExpected: {repr(expected)}")
+print(f"Match: {ast == expected}")
