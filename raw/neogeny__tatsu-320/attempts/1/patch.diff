+from tatsu.tool import parse
+
+# Test if constants match the literal backtick content
+grammar = '''
+start = x $;
+x = `hello` ;
+'''
+
+print("Testing if constants consume backticks:")
+try:
+    # This should match the literal string `hello` including backticks
+    ast = parse(grammar, '`hello`')
+    print(f"Result: {repr(ast)}")
+except Exception as e:
+    print(f"Error: {e}")
+
+# Test what the constant should produce
+print("\nTesting constant evaluation:")
+try:
+    ast = parse(grammar, '`hello`')
+    print(f"Result: {repr(ast)}")
+    if hasattr(ast, 'x'):
+        print(f"x = {repr(ast.x)} (type: {type(ast.x)})")
+except Exception as e:
+    print(f"Error: {e}")
