+from tatsu.tool import parse
+
+# Test what happens with different constant values
+grammars = [
+    '''
+    @@grammar :: constants
+    start = int bool str null 'a' $;
+    int = `42` ;
+    bool = `True` ;
+    str = `Something` ;
+    null = `None` ;
+    ''',
+    '''
+    start = int bool str null 'a' $;
+    int = `42` ;
+    bool = `True` ;
+    str = `Something` ;
+    null = `None` ;
+    '''
+]
+
+for i, grammar in enumerate(grammars):
+    print(f"\nTest {i+1}:")
+    try:
+        ast = parse(grammar, 'a')
+        print(f"Result: {repr(ast)}")
+        if hasattr(ast, '__len__'):
+            print(f"Length: {len(ast)}")
+            for j, item in enumerate(ast):
+                print(f"  [{j}]: {repr(item)} (type: {type(item).__name__})")
+    except Exception as e:
+        print(f"Error: {e}")
