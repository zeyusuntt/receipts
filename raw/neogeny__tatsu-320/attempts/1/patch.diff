+int = `42` ;
+bool = `True` ;
+str = `Something` ;
+null = `None` ;
+'''
+
+print("Testing normal constant usage:")
+ast = parse(grammar, 'a')
+print(f"Result: {repr(ast)}")
+if hasattr(ast, '__len__'):
+    print(f"Length: {len(ast)}")
