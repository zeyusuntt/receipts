+class RecipeSchemaNotFound(SchemaOrgException):
+    """No schema.org recipe metadata found on the page."""
+
+    def __init__(self, url):
+        self.url = url
+        message = f"No Recipe Schema found at {url}."
+        super().__init__(message)
+
