+                    '__reduce__': lambda self: (_NewType, (name, tp)),
+                }
+            )
+        def __call__(self, value):
+            return self._type(value)
+        def __reduce__(self):
+            return (_NewType, (self.name, self.tp))
+        # For attributes access
+        def __getattr__(self, item):
+            return getattr(self._type, item)
+        def __repr__(self):
+            return f"{self._type.__module__}.{self.name}"
