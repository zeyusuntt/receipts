@@ -51,18 +55,42 @@ def html_params(**kwargs):
         ``data_`` args convert all underscores to hyphens, instead of
         only the first one.
     """
-    params = []
-    for k, v in sorted(kwargs.items()):
+    # Normalize parameter names and collect values
+    normalized_params = {}
+    for k, v in kwargs.items():
+        # Convert parameter names
         if k in ("class_", "class__", "for_"):
             k = k[:-1]
         elif k.startswith("data_") or k.startswith("aria_"):
             k = k.replace("_", "-")
+        
+        # Skip False values
+        if v is False:
+            continue
+            
+        # Handle True values (boolean attributes)
         if v is True:
-            params.append(k)
