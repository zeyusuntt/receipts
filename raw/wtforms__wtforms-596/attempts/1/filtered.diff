-            pass
+            normalized_params[k] = normalized_params.get(k, []) + [True]
         else:
-            params.append('{}="{}"'.format(str(k), escape(v)))
+            # Collect string values
+            normalized_params[k] = normalized_params.get(k, []) + [str(v)]
+    
+    # Build parameter strings
+    params = []
+    for k in sorted(normalized_params.keys()):
+        values = normalized_params[k]
+        # Filter out True values for special handling
+        true_values = [v for v in values if v is True]
+        str_values = [v for v in values if isinstance(v, str)]
+        
+        if true_values:
+            # Boolean attribute - present if any True value exists
+            params.append(k)
+        elif str_values:
+            # For class attributes, join multiple values with space
+            # For other attributes, join with space as well (consistent behavior)
+            params.append('{}="{}"'.format(k, escape(" ".join(str_values))))
+    
     return " ".join(params)
 
 
