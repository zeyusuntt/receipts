+    def _is_post_admission_rejection(self, profile: AgentProfile, failure: ProviderFailure) -> bool:
+        """
+        Determine if a provider rejection should be treated as a post-admission rejection.
+        
+        This occurs when:
+        1. The failure condition is "provider_rejected" (typically 4xx errors like 404)
+        2. The profile's route has already been proven successful in this run
+        
+        Such failures are treated as their own condition rather than immediate hard failures.
+        """
+        # Check if we're tracking proven routes and this profile's route is proven
+        if hasattr(self, '_routes_proven'):
+            return (
+                failure.condition == "provider_rejected" and
+                profile.profile_id in self._routes_proven
+            )
+        return False
