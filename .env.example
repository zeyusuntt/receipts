# Copy this file to .env (which git ignores) and fill in your own values.

# Nebius Token Factory, OpenAI-compatible: the model calls for `receipts fix` and the official grading.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Token Factory Sandboxes project id, for --executor tokenfactory (shown in the console's project switcher).
NEBIUS_AI_PROJECT=

# Optional: Daytona sandboxes, for --executor daytona.
DAYTONA_API_KEY=
